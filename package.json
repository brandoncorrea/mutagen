{
  "name": "@bwawan/mutagen",
  "version": "0.1.0",
  "description": "Lightweight regex-based mutation testing for JavaScript",
  "license": "MIT",
  "author": "Brandon Correa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandoncorrea/mutagen.git"
  },
  "keywords": [
    "mutation-testing",
    "mutation",
    "testing",
    "vitest",
    "stryker"
  ],
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "core/",
    "cli/",
    "runners/",
    "stryker.js",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": "./index.js",
    "./patterns": "./core/patterns.js",
    "./runners/vitest": "./runners/vitest.js",
    "./stryker": "./stryker.js"
  },
  "peerDependencies": {
    "js-tokens": ">=4.0.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mutate": "node ./scripts/self-mutate.js",
    "mutate:json": "node ./scripts/self-mutate.js --json"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
    "js-tokens": "^4.0.0",
    "vitest": "^4.1.2"
  }
}
