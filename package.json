{
  "name": "@bwawan/mutagen",
  "version": "0.1.0",
  "description": "Lightweight regex-based mutation testing for JavaScript",
  "license": "MIT",
  "author": "Brandon Correa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brandoncorrea/mutagen.git"
  },
  "keywords": [
    "mutation-testing",
    "mutation",
    "testing",
    "vitest",
    "stryker"
  ],
  "type": "module",
  "main": "index.js",
  "bin": {
    "mutagen": "bin/mutagen.js"
  },
  "files": [
    "index.js",
    "bin/",
    "core/",
    "cli/",
    "runners/",
    "stryker.js",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "exports": {
    ".": "./index.js",
    "./mutators": "./core/mutators.js",
    "./patterns": "./core/patterns.js",
    "./runners/vitest": "./runners/vitest.js",
    "./stryker": "./stryker.js"
  },
  "dependencies": {
    "@babel/parser": "^7.29.2",
    "js-tokens": "^4.0.0",
    "picomatch": "^4.0.4"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mutate": "node bin/mutagen.js --all",
    "mutate:dry": "node bin/mutagen.js --all --dry-run",
    "mutate:incremental": "node bin/mutagen.js --incremental",
    "mutate:json": "node bin/mutagen.js --all --json"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",
    "vitest": "^4.1.2"
  }
}
